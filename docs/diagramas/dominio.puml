@startuml Vitalis-Diagrama-de-Classes-Sprint-2
' Vitalis - Sistema de Informacao Hospitalar
' Sprint 2 - PUC Minas - Engenharia de Software - Programacao Modular

skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

package "model" {

    abstract class Pessoa {
        # id : Long
        # nome : String
        # telefone : String
        # email : String
        # ativo : boolean
        + {abstract} getIdentificacaoPrincipal() : String
        + {abstract} getTipo() : String
    }

    class Paciente extends Pessoa {
        - cpf : String
        - dataNascimento : LocalDate
        - endereco : Endereco
        + getIdade() : int
        + estaInternado() : boolean
    }

    abstract class ProfissionalSaude extends Pessoa {
        # registroProfissional : String
        # disponibilidades : List<Disponibilidade>
        + {abstract} podeRealizar(a : Atendimento) : boolean
        + {abstract} getAtribuicao() : String
        + estaDisponivelEm(ini : LocalDateTime, fim : LocalDateTime) : boolean
        + possuiConflito(novo : Atendimento) : boolean
    }

    class ClinicoGeral extends ProfissionalSaude {
        + encaminhar(pacienteId : Long, e : Especialidade, motivo : String) : Encaminhamento
    }

    class Especialista extends ProfissionalSaude {
        - especialidade : Especialidade
        + atendeNaEspecialidade(e : Especialidade) : boolean
    }

    class Cirurgiao extends ProfissionalSaude {
        - areaCirurgica : String
    }

    class Encaminhamento {
        - id : Long
        - origem : ClinicoGeral
        - paciente : Paciente
        - especialidadeDestino : Especialidade
        - motivo : String
        - emitidoEm : LocalDateTime
        - atendido : boolean
        + marcarComoAtendido() : void
    }

    class Endereco <<value object>> {
        - logradouro : String
        - numero : String
        - bairro : String
        - cidade : String
        - uf : UF
        - cep : String
    }

    class Disponibilidade {
        - diaSemana : DiaSemana
        - horaInicio : LocalTime
        - horaFim : LocalTime
        - ativo : boolean
        + cobre(momento : LocalDateTime) : boolean
        + sobrepoe(outra : Disponibilidade) : boolean
    }

    abstract class Atendimento {
        # id : Long
        # paciente : Paciente
        # profissional : ProfissionalSaude
        # observacoes : String
        # criadoEm : LocalDateTime
        + {abstract} getInicio() : LocalDateTime
        + {abstract} getFim() : LocalDateTime
        + {abstract} validarCondicoes() : void
        + conflitaCom(outro : Atendimento) : boolean
        + ocupaAgenda() : boolean
    }

    abstract class Consulta extends Atendimento {
        # motivo : String
        # status : StatusConsulta
        + confirmar() : void
        + iniciar() : void
        + concluir(obs : String) : void
        + cancelar() : void
        + registrarNaoComparecimento() : void
    }

    abstract class ConsultaAgendada extends Consulta {
        - inicio : LocalDateTime
        - duracaoMinutos : int
        - agenda : AgendaService
        + validarAgenda() : void
        + getData() : LocalDate
        + getHorario() : LocalTime
    }

    class ConsultaRotina extends ConsultaAgendada {
        + validarCondicoes() : void
    }

    class ConsultaEspecializada extends ConsultaAgendada {
        - especialidade : Especialidade
        + validarCondicoes() : void
    }

    class AtendimentoEmergencia extends Consulta {
        - prioridade : PrioridadeEmergencia
        - chegadaEm : LocalDateTime
        + validarCondicoes() : void
        + aguardaAvaliacao() : boolean
        + ocupaAgenda() : boolean
    }

    class ProcedimentoCirurgico extends Atendimento {
        - descricao : String
        - tipoCirurgia : String
        - observacoesPreOperatorias : String
        - observacoesPosOperatorias : String
        - dataHoraPrevista : LocalDateTime
        - dataHoraEfetiva : LocalDateTime
        - dataHoraConclusao : LocalDateTime
        - status : StatusProcedimento
        + iniciar(inicio : LocalDateTime) : void
        + concluir(dataHoraConclusao : LocalDateTime, obsPos : String) : void
        + cancelar() : void
        + validarCondicoes() : void
    }

    class Internacao extends Atendimento {
        - quarto : Quarto
        - dataEntrada : LocalDateTime
        - dataPrevistaAlta : LocalDate
        - dataEfetivaAlta : LocalDateTime
        - status : StatusInternacao
        + registrarAlta(d : LocalDateTime, obs : String) : void
        + transferirPara(novo : Quarto) : void
        + estaAtiva() : boolean
        + validarCondicoes() : void
    }

    class Quarto {
        - numero : String
        - andar : int
        - capacidadeMaxima : int
        - tipo : TipoQuarto
        - situacao : SituacaoQuarto
        + getOcupacaoAtual() : int
        + estaDisponivel() : boolean
        + aceita(p : Paciente) : boolean
        + ocupar(i : Internacao) : void
        + liberar(i : Internacao) : void
        + atualizarSituacao() : void
    }

    class RegistroClinico {
        - atendimento : Atendimento
        - autor : ProfissionalSaude
        - tipo : TipoRegistro
        - descricao : String
        - dataRegistro : LocalDateTime
    }

    class HistoricoMedico <<aggregate>> {
        - paciente : Paciente
        - atendimentos : List<Atendimento>
        - registros : List<RegistroClinico>
        + getUltimoAtendimento() : Atendimento
        + filtrarPorPeriodo(ini : LocalDate, fim : LocalDate) : List<Atendimento>
    }
}

package "comum" {
    interface EstadoTransicionavel<E> {
        + getEstado() : E
        + transicoesValidasDe(atual : E) : Set<E>
        + podeTransitarPara(novo : E) : boolean
        + transitarPara(novo : E) : void
    }
}

package "model.enums" {
    enum StatusConsulta {
        AGENDADA
        CONFIRMADA
        EM_ATENDIMENTO
        CONCLUIDA
        CANCELADA
        NAO_COMPARECEU
    }
    enum PrioridadeEmergencia {
        BAIXA
        MODERADA
        ALTA
        CRITICA
    }
    enum StatusProcedimento {
        AGENDADO
        EM_ANDAMENTO
        CONCLUIDO
        CANCELADO
    }
    enum Especialidade {
        CARDIOLOGIA
        NEUROLOGIA
        ORTOPEDIA
        PEDIATRIA
        GINECOLOGIA
        CIRURGIA_GERAL
    }
    enum StatusInternacao {
        ATIVA
        ALTA_CONCEDIDA
        TRANSFERIDA
        CANCELADA
    }
    enum SituacaoQuarto {
        DISPONIVEL
        OCUPADO
        MANUTENCAO
        INTERDITADO
    }
    enum TipoQuarto {
        ENFERMARIA
        APARTAMENTO
        UTI
        ISOLAMENTO
    }
}

StatusConsulta ..|> EstadoTransicionavel

Paciente "1" *-- "1" Endereco : possui >
Paciente "1" o-- "0..*" Atendimento : recebe >
ProfissionalSaude "1" o-- "0..*" Atendimento : realiza >
ProfissionalSaude "1" *-- "0..*" Disponibilidade : define >
ClinicoGeral "1" o-- "0..*" Encaminhamento : emite >
Cirurgiao "1" o-- "0..*" ProcedimentoCirurgico : executa >
Quarto "1" o-- "0..*" Internacao : aloja >
Atendimento "1" *-- "0..*" RegistroClinico : gera >
HistoricoMedico "1" --> "1" Paciente : consolida >

Especialista ..> Especialidade
Encaminhamento ..> Especialidade
Consulta ..> StatusConsulta
ConsultaEspecializada ..> Especialidade
AtendimentoEmergencia ..> PrioridadeEmergencia
ProcedimentoCirurgico ..> StatusProcedimento
Internacao ..> StatusInternacao
Quarto ..> SituacaoQuarto
Quarto ..> TipoQuarto

@enduml
